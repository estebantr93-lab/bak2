# /etc/systemd/system/gunicorn-sgr.service
# Ejecuta la aplicación Django con gunicorn; nginx le envía las peticiones por un socket Unix.
[Unit]
Description=SGR (Django) con gunicorn
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/srv/sgr
# El .env de /srv/sgr lo carga Django (python-dotenv); no se repiten secretos aquí.
RuntimeDirectory=sgr
ExecStart=/srv/sgr/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 --timeout 60 \
    --bind unix:/run/sgr/gunicorn.sock --umask 007 \
    --access-logfile - --error-logfile -
Restart=on-failure

[Install]
WantedBy=multi-user.target
