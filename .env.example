# Obligatoria. Generar una propia con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Desarrollo: True. Producción (AWS): False.
DEBUG=True
# Producción: agregar la IP pública o el DNS de la instancia EC2, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1
# Producción: URL completa con esquema, por ejemplo http://ec2-3-80-1-2.compute-1.amazonaws.com
CSRF_TRUSTED_ORIGINS=
# True solo si nginx atiende HTTPS delante de gunicorn
BEHIND_HTTPS_PROXY=False

# Base de datos MySQL / MariaDB (local o Amazon RDS)
DB_ENGINE=django.db.backends.mysql
DB_NAME=sgr
DB_USER=sgr_app
DB_PASSWORD=cambiar-esta-clave
DB_HOST=127.0.0.1
DB_PORT=3306
# En RDS: DB_HOST=<endpoint>.rds.amazonaws.com y, para TLS, la ruta al bundle de AWS
DB_SSL_CA=
DB_CONN_MAX_AGE=60

# Sesión / cookies (True solo en producción con HTTPS)
COOKIE_SECURE=False

# Correo: consola en desarrollo; para Mailtrap/SMTP usar
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend y completar lo siguiente
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Contraseña de las cuentas de demostración que crea seed_data (no se versiona).
# Si se deja vacía, seed_data genera contraseñas aleatorias y las muestra una sola vez.
# También se puede fijar por usuario: DEMO_PASSWORD_ADMIN_CENTRO=...
DEMO_PASSWORD=
