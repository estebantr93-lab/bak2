SECRET_KEY=change-this-secret-key-in-your-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL / MariaDB (local o Amazon RDS)
DB_ENGINE=django.db.backends.mysql
DB_NAME=sgr
DB_USER=sgr_app
DB_PASSWORD=cambiar-esta-clave
DB_HOST=127.0.0.1
DB_PORT=3306
# En RDS: DB_HOST=<endpoint>.rds.amazonaws.com y, para TLS, la ruta al bundle de AWS
DB_SSL_CA=
DB_CONN_MAX_AGE=60

# Sesión / cookies (True solo en producción con HTTPS)
COOKIE_SECURE=False

# Correo: consola en desarrollo; para Mailtrap/SMTP usar
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend y completar lo siguiente
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
